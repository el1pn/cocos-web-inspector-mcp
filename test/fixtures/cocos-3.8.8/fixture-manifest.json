{
  "contractVersion": 1,
  "creatorVersion": "3.8.8",
  "entryScene": "assets/scenes/InspectorTest.scene",
  "runtime": {
    "scenePaths": {
      "Canvas": [
        "cc.UITransform",
        "cc.Canvas"
      ],
      "Canvas/Panel": [
        "cc.UITransform",
        "InspectorFixture"
      ],
      "Canvas/Panel/TitleLabel": [
        "cc.UITransform",
        "cc.Label"
      ],
      "Canvas/Panel/TestButton": [
        "cc.UITransform",
        "cc.Button"
      ],
      "Canvas/UICamera": [
        "cc.UITransform",
        "cc.Camera"
      ]
    },
    "canaries": {
      "publicValues": {
        "Canvas/Panel.InspectorFixture.title": "Inspector fixture",
        "Canvas/Panel.InspectorFixture.count": 42,
        "Canvas/Panel.InspectorFixture.featureEnabled": true,
        "Canvas/Panel.InspectorFixture.details.category": "manual-test"
      },
      "redaction": {
        "property": "Canvas/Panel.InspectorFixture.details.password",
        "forbiddenValue": "must-not-be-returned"
      },
      "getterSafety": {
        "property": "Canvas/Panel.InspectorFixture.mustNotRun",
        "mustInvoke": false,
        "forbiddenError": "Property getter was invoked"
      }
    }
  },
  "build": {
    "platform": "web-mobile",
    "outputDirectory": "build/inspector-web",
    "steps": [
      "Open this project in Cocos Creator 3.8.8.",
      "Open assets/scenes/InspectorTest.scene.",
      "In the Build panel, select Web Mobile and set the output directory to build/inspector-web.",
      "Build the project from the Build panel."
    ],
    "expectedFiles": [
      "index.html",
      "application.js",
      "src/settings.json",
      "assets/main/config.json"
    ],
    "artifactExclusions": [
      "**/*.map",
      "manual-check.png"
    ]
  },
  "verification": [
    "Confirm every build.expectedFiles path exists below build.outputDirectory.",
    "Confirm src/settings.json launches db://assets/scenes/InspectorTest.scene.",
    "Serve the build in Chromium with CDP on port 9222, then verify runtime.scenePaths and runtime.canaries through cocos-web-inspector.",
    "Run git diff --check."
  ],
  "checksumHandoff": {
    "algorithm": "SHA256",
    "scope": "build/inspector-web",
    "exclude": [
      "**/*.map",
      "manual-check.png"
    ],
    "pathFormat": "Forward-slash paths relative to build/inspector-web",
    "ordering": "Ordinal ascending by relative path",
    "lineFormat": "<lowercase-sha256>  <relative-path>",
    "requiredStatus": [
      "creatorVersion",
      "platform",
      "sourceCommit",
      "dirtyState",
      "verificationResult",
      "fileCount"
    ],
    "requiredFiles": [
      "fixture-manifest.json",
      "build-checksums.sha256"
    ]
  }
}
