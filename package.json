{
  "name": "cocos-web-inspector-mcp",
  "version": "0.1.9",
  "description": "MCP server to inspect and debug Cocos Creator 3.x web builds in local Chromium over CDP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/el1pn/cocos-web-inspector-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/el1pn/cocos-web-inspector-mcp/issues"
  },
  "homepage": "https://github.com/el1pn/cocos-web-inspector-mcp#readme",
  "type": "module",
  "bin": {
    "cocos-web-inspector-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:built": "node --test dist/test/self-test.js",
    "test": "npm run build && npm run test:built",
    "test:integration": "npm run build && node --test dist/test/integration-test.js",
    "test:package": "node test/package-test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "check": "npm run build && npm run test:built && node --test dist/test/integration-test.js && npm run test:package",
    "install:chromium": "playwright-core install chromium --only-shell",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
